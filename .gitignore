# Local vocabulary denylist — intentionally NEVER committed.
# It holds the literal internal terms this project must not publish; shipping
# that list would publish them. See CONTRIBUTING.md.
.vocabulary-denylist

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local config and ingested data
warrant.yaml
.env
*.local.yaml
data/
.artifacts/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Loose image drops (screenshots, photos, pasted references).
# The vocabulary checker cannot read images, so a screenshot of an internal
# diagram would pass CI and land in public history. Commit images only
# deliberately, into docs/assets/, after looking at them.
*.jpeg
*.jpg
*.png
*.heic
*.webp
!docs/assets/**
